# HYPE DROP MX — variables de entorno
# Copia este archivo como .env y llena TUS valores. Nunca subas el .env
# a GitHub ni compartas estos valores en chats o capturas.

# Twilio (panel de Twilio > Account Info y API keys & tokens)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Opcional: solo para validar la firma X-Twilio-Signature del webhook
TWILIO_AUTH_TOKEN=

# Supabase (panel de Supabase > Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Puerto del servidor (Render/Railway lo ponen solo)
PORT=3000
